<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:PkgLens.Core.Shared"
        x:Class="PkgLens.Gui.Views.ContentDecryptReportDialog"
        x:DataType="core:ContentDecryptReport"
        Title="Package content decryption" Width="940" Height="580" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <TextBlock Text="{Binding Summary}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,10,0,10" Opacity="0.8" />
    <SelectableTextBlock Grid.Row="2" Text="{Binding OutputDirectory}" TextWrapping="Wrap" />
    <CheckBox Grid.Row="3" x:Name="AttentionOnly" Content="Show only files that need attention"
              IsCheckedChanged="OnFilterChanged" Margin="0,10" />
    <DataGrid Grid.Row="4" x:Name="Results" x:DataType="core:ContentDecryptItem" IsReadOnly="True" AutoGenerateColumns="False"
              GridLinesVisibility="Horizontal" CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="File" Width="2*" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="core:ContentDecryptItem">
              <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Margin="6" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Result" Binding="{Binding StatusText}" Width="120" />
        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="120" />
        <DataGridTemplateColumn Header="Details" Width="3*" MinWidth="180">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="core:ContentDecryptItem">
              <StackPanel Margin="6" Spacing="4">
                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding ContentId}" FontSize="11" TextWrapping="Wrap" Opacity="0.7" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
      <TextBlock Text="Text and JSON reports are saved beside the files folder." TextWrapping="Wrap"
                 VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.7" />
      <Button Grid.Column="1" Content="Open output folder" Click="OnOpenFolder" Margin="0,0,8,0" />
      <Button Grid.Column="2" Content="Close" Click="OnClose" />
    </Grid>
  </Grid>
</Window>

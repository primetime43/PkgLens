<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PkgLens.Gui.Views.EdatWorkbenchDialog" Title="EDAT / SDAT tools"
        Width="780" Height="760" MinWidth="620" MinHeight="500" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Spacing="5" Margin="0,0,0,16">
      <TextBlock Text="EDAT / SDAT tools" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Decrypt, encrypt, or rebuild PS3 data files. Originals are kept; rebuilt files are verified before saving."
                 TextWrapping="Wrap" Opacity="0.75" />
    </StackPanel>
    <ScrollViewer Grid.Row="1">
      <StackPanel x:Name="Inputs" Spacing="14" Margin="0,0,8,0">
        <Grid ColumnDefinitions="140,*">
          <TextBlock Text="Operation" VerticalAlignment="Center" />
          <ComboBox x:Name="Operation" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged">
            <ComboBoxItem Content="Decrypt only" /><ComboBoxItem Content="Encrypt plaintext" />
            <ComboBoxItem Content="Quick rebuild" /><ComboBoxItem Content="Custom rebuild" />
          </ComboBox>
        </Grid>
        <TextBlock x:Name="ModeHelp" TextWrapping="Wrap" Opacity="0.8" />
        <Grid ColumnDefinitions="140,Auto,*">
          <TextBlock Text="Source file" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="ChooseSource" Content="Browse…" Click="OnChooseSource" />
          <TextBlock Grid.Column="2" x:Name="SourceName" Text="No file selected" Margin="10,0,0,0"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="SourceInfo" TextWrapping="Wrap" Opacity="0.75" />
        <Grid x:Name="ReplacementPanel" ColumnDefinitions="140,Auto,*,Auto">
          <TextBlock Text="New plaintext" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Replace with…" Click="OnChooseReplacement" />
          <TextBlock Grid.Column="2" x:Name="ReplacementName" Text="Use original content" Margin="10,0" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="3" Content="Clear" Click="OnClearReplacement" />
        </Grid>
        <StackPanel x:Name="InputKeyPanel" Spacing="8">
          <TextBlock Text="INPUT KEY" FontWeight="SemiBold" FontSize="12" />
          <TextBox x:Name="InputRawKey" Watermark="Raw content / developer key (optional, 32 hex characters)" PasswordChar="●" TextChanged="OnSettingsChanged" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Content="Select RAP…" Click="OnInputRap" />
            <TextBlock Grid.Column="1" x:Name="InputRapName" Text="Automatic key / license lookup" Margin="10,0" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Clear" Click="OnClearInputRap" />
          </Grid>
          <Button x:Name="CheckKeyButton" Content="Check key and file" Click="OnCheckKey" />
          <TextBlock x:Name="KeyCheckStatus" Text="Check which key works before decrypting or rebuilding. No plaintext is saved."
                     TextWrapping="Wrap" />
        </StackPanel>
        <Grid ColumnDefinitions="140,*">
          <TextBlock Text="Output filename" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" x:Name="OutputName" Watermark="file.edat" TextChanged="OnSettingsChanged" />
        </Grid>
        <StackPanel x:Name="OutputSettings" Spacing="10">
          <TextBlock Text="OUTPUT SETTINGS" FontWeight="SemiBold" FontSize="12" />
          <Grid ColumnDefinitions="140,*,100,*" RowDefinitions="Auto,12,Auto,12,Auto,12,Auto">
            <TextBlock Text="Format" VerticalAlignment="Center" />
            <ComboBox x:Name="Format" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnFormatChanged">
              <ComboBoxItem Content="EDAT" /><ComboBoxItem Content="SDAT" />
            </ComboBox>
            <TextBlock Grid.Column="2" Text="Version" Margin="15,0,0,0" VerticalAlignment="Center" />
            <ComboBox x:Name="Version" Grid.Column="3" SelectedIndex="2" HorizontalAlignment="Stretch" SelectionChanged="OnSettingsChanged">
              <ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" />
            </ComboBox>
            <TextBlock Grid.Row="2" Text="License" VerticalAlignment="Center" />
            <ComboBox x:Name="License" Grid.Row="2" Grid.Column="1" SelectedIndex="2" HorizontalAlignment="Stretch" SelectionChanged="OnSettingsChanged">
              <ComboBoxItem Content="Network" /><ComboBoxItem Content="Local (RAP)" /><ComboBoxItem Content="Free" />
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Block size" Margin="15,0,0,0" VerticalAlignment="Center" />
            <ComboBox x:Name="BlockSize" Grid.Row="2" Grid.Column="3" SelectedIndex="4" HorizontalAlignment="Stretch" SelectionChanged="OnSettingsChanged">
              <ComboBoxItem Content="1 KiB" /><ComboBoxItem Content="2 KiB" /><ComboBoxItem Content="4 KiB" />
              <ComboBoxItem Content="8 KiB" /><ComboBoxItem Content="16 KiB" /><ComboBoxItem Content="32 KiB" />
            </ComboBox>
            <TextBlock Grid.Row="4" Text="Content ID" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ContentId" Watermark="Required for EDAT; optional for SDAT" TextChanged="OnSettingsChanged" />
            <TextBlock Grid.Row="6" Text="Application type" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="6" Grid.Column="1" x:Name="AppType" Value="1" Minimum="0" Maximum="4294967295" ValueChanged="OnSettingsChanged" />
          </Grid>
          <TextBox x:Name="OutputRawKey" Watermark="Output content key, or developer key for Free EDAT (optional)" PasswordChar="●" TextChanged="OnSettingsChanged" />
          <Grid x:Name="OutputRapPanel" ColumnDefinitions="Auto,*,Auto">
            <Button Content="Output RAP…" Click="OnOutputRap" />
            <TextBlock Grid.Column="1" x:Name="OutputRapName" Text="Automatic key / license lookup" Margin="10,0" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Clear" Click="OnClearOutputRap" />
          </Grid>
          <Expander x:Name="DeveloperSettings" Header="Developer header key (advanced)">
            <StackPanel Spacing="8">
              <TextBlock Text="For licensed EDAT, this key authenticates the NPD header and can differ from the RAP-derived content key. Blank uses the built-in developer key." TextWrapping="Wrap" />
              <TextBox x:Name="DeveloperKey" Watermark="32 hex characters (optional)" PasswordChar="●" TextChanged="OnSettingsChanged" />
            </StackPanel>
          </Expander>
        </StackPanel>
        <TextBlock Text="Rebuilds write uncompressed data for compatible CFW/HEN or emulator workflows. Sony signatures are not generated."
                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="8" Margin="0,12">
      <ProgressBar x:Name="WorkProgress" IsVisible="False" IsIndeterminate="True" Height="4" />
      <TextBlock x:Name="Status" Text="Choose a source file and an operation." TextWrapping="Wrap" />
    </StackPanel>
    <WrapPanel Grid.Row="3" Orientation="Horizontal">
      <Button x:Name="BuildButton" Content="Build and verify" Click="OnBuild" Classes="primary" Margin="0,0,8,8" />
      <Button x:Name="PreviewButton" Content="Preview plaintext" Click="OnPreview" IsEnabled="False" Margin="0,0,8,8" />
      <Button x:Name="SaveButton" Content="Save copy…" Click="OnSave" IsEnabled="False" Margin="0,0,8,8" />
      <Button x:Name="StageButton" Content="Stage in package" Click="OnStage" IsVisible="False" IsEnabled="False" Margin="0,0,8,8" />
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsVisible="False" Margin="0,0,8,8" />
      <Button x:Name="CloseButton" Content="Close" Click="OnClose" Margin="0,0,8,8" />
    </WrapPanel>
  </Grid>
</Window>

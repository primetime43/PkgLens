<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:PkgLens.Gui.Services" x:Class="PkgLens.Gui.Views.PackageKeyCoverageDialog"
        x:DataType="svc:PackageKeyCoverageReport" Title="Package key coverage"
        Width="960" Height="680" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
    <TextBlock Text="{Binding Summary}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" Text="{Binding Note}" Margin="0,10" TextWrapping="Wrap" Opacity="0.8" />
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBox x:Name="Search" Watermark="Filter by filename, content ID, or key source…" TextChanged="OnFilterChanged" />
      <CheckBox x:Name="AttentionOnly" Grid.Column="1" Content="Needs attention only" Margin="12,0,0,0" IsCheckedChanged="OnFilterChanged" />
    </Grid>
    <DataGrid Grid.Row="3" x:Name="Results" x:DataType="svc:KeyCoverageItem" AutoGenerateColumns="False"
              IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal" SelectionChanged="OnSelectionChanged">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="File" Width="3*" MinWidth="150">
          <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="svc:KeyCoverageItem">
            <TextBlock Text="{Binding DisplayPath}" TextWrapping="Wrap" Margin="10,7" />
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Result" Width="160">
          <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="svc:KeyCoverageItem">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="10,7" />
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="120" />
        <DataGridTemplateColumn Header="Key source" Width="2*" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="svc:KeyCoverageItem">
            <TextBlock Text="{Binding KeySource}" TextWrapping="Wrap" Margin="10,7" />
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="4" x:Name="RowCount" Margin="0,6" Opacity="0.7" />
    <Border Grid.Row="5" Padding="12" BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ScrollViewer MaxHeight="135">
        <SelectableTextBlock x:Name="Details" Text="Select a file for its verification details and next steps." TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>
    <WrapPanel Grid.Row="6" Margin="0,14,0,0">
      <Button Content="Scan again" Click="OnRescan" Margin="0,0,8,8" />
      <Button Content="Save report…" Click="OnSave" Margin="0,0,8,8" />
      <Button Content="Close" Click="OnClose" Margin="0,0,8,8" />
    </WrapPanel>
  </Grid>
</Window>

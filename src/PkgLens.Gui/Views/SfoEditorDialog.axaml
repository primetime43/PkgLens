<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PkgLens.Gui.ViewModels"
        x:Class="PkgLens.Gui.Views.SfoEditorDialog"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Edit PARAM.SFO">

  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Opacity="0.7" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
               Text="Edit values, remove keys with ✕, or add a new key below. Changes are queued — use File → Save As to write a new .pkg with the patched PARAM.SFO." />

    <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="#E5484D" FontSize="12"
               IsVisible="False" Margin="0,8,0,0" TextWrapping="Wrap" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Apply" Click="OnApply" />
    </StackPanel>

    <!-- Add-a-key row -->
    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="8" BorderThickness="1" CornerRadius="3"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="Add a key" FontWeight="SemiBold" FontSize="12" />
        <Grid ColumnDefinitions="170,70,*,Auto">
          <TextBox  Grid.Column="0" x:Name="NewKeyBox" Watermark="KEY_NAME" FontFamily="Consolas,monospace" Margin="0,0,6,0" />
          <ComboBox Grid.Column="1" x:Name="NewKeyType" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,6,0">
            <ComboBoxItem>text</ComboBoxItem>
            <ComboBoxItem>int</ComboBoxItem>
          </ComboBox>
          <TextBox  Grid.Column="2" x:Name="NewKeyValue" Watermark="value" Margin="0,0,6,0" />
          <Button   Grid.Column="3" Content="Add" Click="OnAddKey" />
        </Grid>
      </StackPanel>
    </Border>

    <ScrollViewer>
      <ItemsControl x:Name="Rows">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SfoEditRow">
            <Grid ColumnDefinitions="170,44,*,Auto" Margin="0,3">
              <TextBlock Grid.Column="0" Text="{Binding Key}" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" VerticalAlignment="Center" Opacity="0.5" FontSize="11" />
              <TextBox   Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" />
              <Button    Grid.Column="3" Content="✕" Click="OnRemoveRow" Margin="6,0,0,0" Padding="8,4"
                         ToolTip.Tip="Remove this key" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>

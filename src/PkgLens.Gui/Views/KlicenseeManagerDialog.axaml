<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PkgLens.Gui.ViewModels"
        x:Class="PkgLens.Gui.Views.KlicenseeManagerDialog"
        Width="980" Height="540" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" Title="Klicensee Library">

  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
      <TextBlock Text="Saved klicensees are matched before the bundled known-key catalog by content ID, title ID, SELF filename, and license type. Bundled mappings are read-only, and only one-way fingerprints are displayed."
                 TextWrapping="Wrap" Opacity="0.75" />
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="Database" VerticalAlignment="Center" FontWeight="SemiBold" />
        <TextBlock x:Name="PathText" Grid.Column="1" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Button Grid.Column="2" Content="Import list…" Click="OnImport" />
        <Button Grid.Column="3" Content="Refresh" Click="OnRefresh" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="Filter" VerticalAlignment="Center" FontWeight="SemiBold" />
        <TextBox x:Name="FilterBox" Grid.Column="1"
                 Watermark="Content ID, title ID, SELF, source, or fingerprint"
                 TextChanged="OnFilterChanged" />
      </Grid>
      <TextBlock Text="Imports support annotated lines (32-hex key plus a content/title ID) and legacy [klicensee] INI blocks. Raw key-only lists cannot be mapped safely and are skipped."
                 TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button x:Name="RemoveButton" Content="Remove selected" Click="OnRemove" IsEnabled="False" />
      <Button Content="Close" Click="OnClose" IsDefault="True" />
    </StackPanel>

    <DataGrid x:Name="Grid" IsReadOnly="True" GridLinesVisibility="Horizontal"
              HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="OnSelectionChanged"
              CanUserSortColumns="True" CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Content ID" Binding="{Binding ContentId}" Width="270" x:DataType="vm:KlicenseeStoreRow" />
        <DataGridTextColumn Header="Title ID" Binding="{Binding TitleId}" Width="100" x:DataType="vm:KlicenseeStoreRow" />
        <DataGridTextColumn Header="SELF" Binding="{Binding FileName}" Width="120" x:DataType="vm:KlicenseeStoreRow" />
        <DataGridTextColumn Header="License" Binding="{Binding License}" Width="65" x:DataType="vm:KlicenseeStoreRow" />
        <DataGridTextColumn Header="Fingerprint" Binding="{Binding Fingerprint}" Width="110" x:DataType="vm:KlicenseeStoreRow" />
        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150" x:DataType="vm:KlicenseeStoreRow" />
        <DataGridTextColumn Header="Added" Binding="{Binding Added}" Width="*" x:DataType="vm:KlicenseeStoreRow" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>

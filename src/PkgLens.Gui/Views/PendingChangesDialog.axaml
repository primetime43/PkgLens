<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PkgLens.Gui.ViewModels"
        xmlns:services="using:PkgLens.Gui.Services"
        x:Class="PkgLens.Gui.Views.PendingChangesDialog"
        x:DataType="vm:PackageViewModel"
        Title="Pending changes" Width="680" Height="420" MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
    <StackPanel Spacing="6">
      <TextBlock Classes="pagetitle" Text="Pending changes" />
      <TextBlock Text="{Binding PendingChangesSummary}" FontWeight="SemiBold" />
      <TextBlock Classes="pagesubtitle" Text="Revert restores a file to the version in the opened package. Save copy writes your changes to a new package." />
    </StackPanel>
    <Grid Grid.Row="1">
      <ScrollViewer IsVisible="{Binding HasPendingChanges}" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ChangesList" ItemsSource="{Binding PendingChanges}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="services:PendingPackageChange">
              <Border Classes="panel" Padding="12" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Opacity="0.75">
                      <Run Text="{Binding OriginalSize}" /><Run Text=" → " /><Run Text="{Binding NewSize}" />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Revert" Click="OnRevert" Tag="{Binding}"
                          VerticalAlignment="Center" ToolTip.Tip="Discard the pending change to this file" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock IsVisible="{Binding !HasPendingChanges}" Text="All changes have been reverted."
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Close" Click="OnClose" IsCancel="True" />
      <Button x:Name="SaveChangesButton" Classes="primary" Content="Save copy…" Click="OnSave"
              IsEnabled="{Binding HasPendingChanges}" />
    </StackPanel>
  </Grid>
</Window>

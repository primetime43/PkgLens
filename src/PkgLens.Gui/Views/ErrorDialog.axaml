<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PkgLens.Gui.Views.ErrorDialog"
        Width="560" SizeToContent="Height" MaxHeight="560" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Operation failed">
  <Grid Margin="18" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="The operation could not be completed." FontSize="16" FontWeight="SemiBold" />
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    </StackPanel>

    <Expander x:Name="DetailsExpander" Grid.Row="1" Header="Technical details">
      <TextBox x:Name="DetailsText" Margin="0,8,0,0" Height="180" Padding="8"
               IsReadOnly="True" AcceptsReturn="True"
               FontFamily="Consolas, Menlo, monospace" FontSize="11"
               TextWrapping="NoWrap"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Expander>

    <Button x:Name="OkButton" Grid.Row="2" Content="OK" Click="OnClose" HorizontalAlignment="Right"
            IsDefault="True" Classes="accent" MinWidth="88" Padding="18,6"
            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
  </Grid>
</Window>

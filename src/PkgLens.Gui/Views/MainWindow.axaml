<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PkgLens.Gui.ViewModels"
        xmlns:core="using:PkgLens.Core.Shared"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="PkgLens.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="860" Height="580"
        MinWidth="620" MinHeight="380"
        DragDrop.AllowDrop="True"
        Title="{Binding WindowTitle}">

  <DockPanel>

    <!-- Menu -->
    <Menu DockPanel.Dock="Top" IsEnabled="{Binding IsNotBusy}">
      <MenuItem Header="_File">
        <MenuItem Header="_Open package…" Click="OnOpenClick"
                  ToolTip.Tip="Open and inspect a PS3, PSP, or PSVita package." />
        <MenuItem Header="_Close package" Click="OnCloseClick" IsEnabled="{Binding HasPackage}"
                  ToolTip.Tip="Close the currently opened package without exiting PkgLens." />
        <Separator />
        <MenuItem Header="_Build and convert">
          <MenuItem Header="_Pack folder into package…" Click="OnGoPackClick"
                    ToolTip.Tip="Open the Pack page to build a new package from an extracted content folder." />
          <MenuItem Header="_Compare packages / create update…" Click="OnComparePackagesClick"
                    ToolTip.Tip="Compare base and target package files and PARAM.SFO values, then create a compact CFW/HEN or RPCS3 overlay package." />
          <MenuItem Header="Convert PS3 package for a _target…" Click="OnConvertCfwClick"
                    ToolTip.Tip="Check RPCS3, CEX CFW, DEX, or HEN compatibility before decrypting, fake-signing, optionally lowering firmware requirements, and rebuilding a package copy." />
        </MenuItem>
        <MenuItem Header="_Export platform content">
          <MenuItem Header="PS_1 Classic → BIN / CUE / metadata…" Click="OnExportPs1ClassicClick"
                    ToolTip.Tip="Identify a PS1 Classic, resolve its RAP, export PBP metadata, and reconstruct emulator-ready BIN/CUE images." />
          <MenuItem Header="PS_2 Classic → ISO / CFW package…" Click="OnExportPs2ClassicClick"
                    ToolTip.Tip="Authenticate and decrypt ISO.BIN.ENC to ISO, with an optional CFW/HEN package rebuild." />
          <MenuItem Header="_PSP → PBP / ISO / CSO…" Click="OnExportPspClick"
                    ToolTip.Tip="Export a PSP package directly to EBOOT.PBP, decrypted ISO, or compressed CSO." />
          <MenuItem Header="PS_Vita → app / patch / addcont…" Click="OnExportVitaClick"
                    ToolTip.Tip="Export a Vita package into the correct app, patch, or addcont directory layout." />
        </MenuItem>
        <MenuItem Header="_Extract and repack">
          <MenuItem Header="Browse / rebuild _PSARC archive…" Click="OnBrowsePsarcClick"
                    ToolTip.Tip="Browse, extract, queue replacements, and rebuild a verified copy of a standard zlib PSARC archive." />
          <Separator />
          <MenuItem Header="Extract _all files…" Click="OnExtractAllClick"
                    IsEnabled="{Binding Package.IsDecrypted, FallbackValue=False}"
                    ToolTip.Tip="Extract the currently opened package and recreate its directory tree on disk." />
          <MenuItem Header="Save package _as…" Click="OnSaveAsClick"
                    IsEnabled="{Binding Package.IsDecrypted, FallbackValue=False}"
                    ToolTip.Tip="Rebuild a separate package containing replacements or PARAM.SFO edits. The original remains unchanged." />
        </MenuItem>
        <Separator />
        <MenuItem Header="E_xit PkgLens" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Edit _PARAM.SFO…" Click="OnEditSfoClick"
                  IsEnabled="{Binding Package.CanEditSfo, FallbackValue=False}" />
        <MenuItem Header="_Replace selected file…" Click="OnReplaceClick"
                  IsEnabled="{Binding Package.HasSelectedFile, FallbackValue=False}" />
        <Separator />
        <MenuItem Header="E_xtract selected file…" Click="OnExtractClick"
                  IsEnabled="{Binding Package.HasSelectedFile, FallbackValue=False}" />
        <MenuItem Header="_View selected file…" Click="OnViewClick"
                  IsEnabled="{Binding Package.HasSelectedFile, FallbackValue=False}" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="Analyze / patch package _firmware…"
                  Click="OnFirmwareAnalysisClick"
                  ToolTip.Tip="Scan every SELF/SPRX, report the required firmware, and offer safe package patching when supported." />
        <Separator />
        <MenuItem Header="_Firmware and CFW">
          <MenuItem Header="Analyze extracted firmware _folder…"
                    Click="OnFirmwareFolderAnalysisClick"
                    ToolTip.Tip="Scan SELF and SPRX files in an extracted folder and report their firmware requirements." />
          <MenuItem Header="_Target compatibility and package conversion…"
                    Click="OnConvertCfwClick"
                    ToolTip.Tip="Choose RPCS3, CEX CFW, DEX, or HEN; explain blocking compatibility failures before conversion starts." />
          <Separator />
          <MenuItem Header="Patch one _SELF / EBOOT firmware…"
                    Click="OnGoFirmwarePatchClick"
                    ToolTip.Tip="Open the guided SELF/EBOOT firmware patch and fake-sign tool." />
          <MenuItem Header="Raw _byte patch SELF / EBOOT…"
                    Click="OnGoBytePatchClick"
                    ToolTip.Tip="Open the advanced byte-patch tool for a single SELF or EBOOT file." />
        </MenuItem>
        <MenuItem Header="_Inspect and verify">
          <MenuItem Header="_Verify package integrity…" Click="OnVerifyClick" IsEnabled="{Binding HasPackage}" />
          <MenuItem Header="Package _info…" Click="OnInfoClick" IsEnabled="{Binding HasPackage}" />
          <MenuItem Header="_Folder info…" Click="OnFolderInfoClick" />
          <MenuItem Header="Key / _license audit…" Click="OnKeyLicenseAuditClick" />
        </MenuItem>
        <MenuItem Header="_Library and batch">
          <MenuItem Header="Scan package _library…" Click="OnScanFolderClick" />
          <MenuItem Header="_Batch processing center…" Click="OnBatchCenterClick" />
          <MenuItem Header="Duplicate / package _organizer…" Click="OnPackageOrganizerClick" />
        </MenuItem>
        <MenuItem Header="_Keys and licenses">
          <MenuItem Header="Import _override key…" Click="OnSetKeyClick" />
          <MenuItem Header="Keys _folder…" Click="OnKeysClick" />
          <MenuItem Header="_RAP library…" Click="OnManageRapsClick" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Theme">
          <MenuItem x:Name="ThemeSystemItem" Header="_System" ToggleType="Radio" Click="OnThemeSystem" />
          <MenuItem x:Name="ThemeLightItem" Header="_Light" ToggleType="Radio" Click="OnThemeLight" />
          <MenuItem x:Name="ThemeDarkItem" Header="_Dark" ToggleType="Radio" Click="OnThemeDark" />
        </MenuItem>
        <Separator />
        <MenuItem x:Name="OperationPreflightItem" Header="Show operation _preflight" ToggleType="CheckBox"
                  Click="OnOperationPreflightChanged" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About PkgLens" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <!-- Toolbar (package-page actions) -->
    <Border DockPanel.Dock="Top" Padding="4,3" IsEnabled="{Binding IsNotBusy}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="3">
        <Button Classes="tool" Click="OnOpenClick" ToolTip.Tip="Open a .pkg file">Open</Button>
        <Border Width="1" Margin="3,2" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                IsVisible="{Binding IsPackageTool}" />
        <Button Classes="tool" Click="OnExtractClick" ToolTip.Tip="Extract the selected file"
                IsVisible="{Binding IsPackageTool}"
                IsEnabled="{Binding Package.HasSelectedFile, FallbackValue=False}">Extract</Button>
        <Button Classes="tool" Click="OnReplaceClick" ToolTip.Tip="Replace the selected file's contents"
                IsVisible="{Binding IsPackageTool}"
                IsEnabled="{Binding Package.HasSelectedFile, FallbackValue=False}">Replace</Button>
        <Button Classes="tool" Click="OnEditSfoClick" ToolTip.Tip="Edit PARAM.SFO"
                IsVisible="{Binding IsPackageTool}"
                IsEnabled="{Binding Package.CanEditSfo, FallbackValue=False}">Edit SFO</Button>
        <Border Width="1" Margin="3,2" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                IsVisible="{Binding IsPackageTool}" />
        <Button Classes="tool" Click="OnSaveAsClick" ToolTip.Tip="Save a repacked copy"
                IsVisible="{Binding IsPackageTool}"
                IsEnabled="{Binding Package.IsDecrypted, FallbackValue=False}">Save As</Button>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="6,3"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding KeyStatus}" FontSize="12" Opacity="0.7" Margin="12,0,0,0" />
        <Grid x:Name="OperationProgressPanel" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,5,0,1"
              IsVisible="{Binding IsBusy}">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Text="{Binding BusyMessage}" FontSize="11" TextTrimming="CharacterEllipsis" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}" Height="4" />
          </StackPanel>
          <Button x:Name="OperationCancelButton" Grid.Column="1" Content="Cancel" Click="OnCancelOperation" Margin="10,0,0,0"
                   Padding="10,2" IsEnabled="{Binding CanCancel}" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>

    <!-- Rail + content -->
    <Grid x:Name="ToolContentShell" ColumnDefinitions="148,*" IsEnabled="{Binding IsNotBusy}">

      <!-- Left tool rail -->
      <DockPanel Grid.Column="0"
                 Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <TextBlock DockPanel.Dock="Top" Text="TOOLS" FontSize="11" FontWeight="SemiBold"
                   Opacity="0.55" Margin="12,10,0,4" />
        <ListBox x:Name="ToolRail" Background="Transparent"
                 BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0"
                 SelectedIndex="{Binding SelectedToolIndex, Mode=TwoWay}">
          <ListBoxItem Content="Home" />
          <ListBoxItem Content="Suggested" />
          <ListBoxItem Content="Package" />
          <ListBoxItem Content="Pack" />
          <ListBoxItem Content="Resign" />
          <ListBoxItem Content="Decrypt" />
          <ListBoxItem Content="Keys" />
        </ListBox>
      </DockPanel>

      <!-- Content host: one panel per page -->
      <Grid Grid.Column="1">

        <!-- ===== Home page (main menu of tasks) ===== -->
        <ScrollViewer x:Name="HomePage" IsVisible="{Binding IsHomeTool}">
          <StackPanel Margin="24,20" Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="3">
              <TextBlock Classes="pagetitle" Text="PkgLens" />
              <TextBlock Classes="pagesubtitle"
                         Text="Keyless PS3 / PSP / PSVita package and EBOOT tools. Each tool is tagged below with the file it works on and where its output runs." />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasRecentPackages}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="sectionhead" Text="RECENT PACKAGES" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Clear history" Click="OnClearRecentPackages"
                        Padding="8,3" FontSize="11" />
              </Grid>
              <Border Classes="panel" Padding="4">
                <ItemsControl ItemsSource="{Binding RecentPackages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentPackageItem">
                      <Button Classes="row" Tag="{Binding}" Click="OnRecentPackageClick"
                              ToolTip.Tip="{Binding FilePath}">
                        <Grid ColumnDefinitions="34,*">
                          <materialIcons:MaterialIcon Grid.Column="0" Kind="History" Width="20" Height="20"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Classes="rowtitle" Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="carddesc" Text="{Binding DirectoryPath}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <!-- Legend: what the tags mean -->
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14,11" MaxWidth="900" HorizontalAlignment="Left">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,6,Auto,6,Auto">
                  <Border Grid.Row="0" Grid.Column="0" Classes="chip cfw" HorizontalAlignment="Left"><TextBlock Text="CEX · CFW" /></Border>
                  <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Opacity="0.85"
                             TextWrapping="Wrap" Text="Output runs on a console with custom firmware / HEN (jailbroken) — the usual retail (CEX) target." />
                  <Border Grid.Row="2" Grid.Column="0" Classes="chip debug" HorizontalAlignment="Left"><TextBlock Text="DEX · OFW" /></Border>
                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Opacity="0.85"
                             TextWrapping="Wrap" Text="Output runs on debug / reference (DEX) consoles on official debug firmware, and in RPCS3 — currently the debug .pkg only." />
                  <Border Grid.Row="4" Grid.Column="0" Classes="chip" HorizontalAlignment="Left"><TextBlock Text="READ-ONLY" /></Border>
                  <TextBlock Grid.Row="4" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Opacity="0.85"
                             TextWrapping="Wrap" Text="Inspects or decrypts to a plaintext file — nothing is signed or installed." />
                </Grid>
                <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,1" />
                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6"
                           Text="A retail console on stock OFW needs a forged Sony signature, which PkgLens never does — so that target is out of scope.  Glossary:  CEX = retail console · DEX = debug/dev console · OFW = official firmware · CFW/HEN = jailbroken." />
              </StackPanel>
            </Border>

            <!-- Packages (.pkg) -->
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionhead" Text="PACKAGES  ·  .PKG" />
              <Border Classes="panel" Padding="4">
                <StackPanel>
                  <Button Classes="row" Click="OnHomeOpenPkg">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="FileOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Open a .pkg…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Browse, list and extract a package." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="PKG" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnHomeScan">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderSearchOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Scan a folder…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Catalog every .pkg in a directory." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="PKG" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnHomeBatch">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="PlaylistPlay" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Batch processing center…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Audit, classify, verify, extract, export, or CFW-convert a package folder with resumable jobs." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="FOLDER" /></Border>
                        <Border Classes="chip"><TextBlock Text="RESUMABLE" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnHomeOrganizer">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderMoveOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Duplicate / package organizer…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Find hash/content duplicates and older updates, then preview a PS3 / PSP / Vita library layout." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="FOLDER" /></Border>
                        <Border Classes="chip"><TextBlock Text="PREVIEW FIRST" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnHomeFolderInfo">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Game folder info…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Read a content folder's PARAM.SFO / EBOOTs." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="FOLDER" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnKeyLicenseAuditClick">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="ShieldKeyOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Key / license audit…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Find required keys, SELF revisions, licenses, missing RAPs and unsupported encryption." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="PKG / FOLDER" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnHomePack">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="PackageVariantClosed" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Pack folder → .pkg" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Build a package from a content folder." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip cfw"><TextBlock Text="CEX · CFW" /></Border>
                        <Border Classes="chip debug"><TextBlock Text="DEX · OFW" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnHomeConvertCfw">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="AutoFix" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Target compatibility and conversion…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Check RPCS3, CEX CFW, DEX, or HEN before rebuilding." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="PKG" /></Border>
                        <Border Classes="chip cfw"><TextBlock Text="RPCS3 · CEX · HEN" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnHomeExportPsp">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="Disc" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Export PSP package → PBP / ISO / CSO…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Locate EBOOT.PBP and export or decrypt its disc image in one step." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="PSP PKG" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnHomeExportPs1">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="DiscPlayer" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Export PS1 Classic → BIN / CUE…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Resolve licenses, preserve metadata, and reconstruct single- or multi-disc images." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="PS1 PKG" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnHomeExportVita">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderMoveOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Export PSVita package…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Identify app, update, DLC or theme and create the correct Vita directory tree." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="VITA PKG" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- SELF / EBOOT executables — grouped by console/firmware target -->
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionhead" Text="SELF / EBOOT EXECUTABLES  ·  PS3" />

              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <Border Classes="chip cfw"><TextBlock Text="CEX · CFW" /></Border>
                <TextBlock Text="retail console · custom firmware" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
              </StackPanel>
              <Border Classes="panel" Padding="4">
                <StackPanel>
                  <Button Classes="row" Tag="inspect" Click="OnHomeResign">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Inspect SELF / EBOOT" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Header — type, key rev, segments." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EBOOT" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Tag="decrypt" Click="OnHomeResign">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="LockOpenOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Decrypt SELF → ELF" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="EBOOT.BIN / .self to a plaintext ELF." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EBOOT" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Tag="fakesign" Click="OnHomeResign">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="DrawPen" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Fake-sign ELF → fSELF" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="A CFW-ready fSELF from a plain ELF." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EBOOT" /></Border>
                        <Border Classes="chip cfw"><TextBlock Text="CFW" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Tag="magic" Click="OnHomeResign">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="ArrowDownBoldBox" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Magic-patch firmware" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Lower the firmware an EBOOT requires." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EBOOT" /></Border>
                        <Border Classes="chip cfw"><TextBlock Text="CFW" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Tag="byte" Click="OnHomeResign">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="CodeBraces" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Byte-patch EBOOT" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Hex find/replace or at-offset edit." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EBOOT" /></Border>
                        <Border Classes="chip cfw"><TextBlock Text="CFW" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Border Classes="chip debug"><TextBlock Text="DEX · OFW" /></Border>
                <TextBlock Text="debug console · official firmware" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="carddesc" Margin="2,0,0,0"
                         Text="No DEX OFW resign yet — resigning SELFs for debug (DEX) firmware isn't built. For DEX today, build a debug .pkg from Pack." />
            </StackPanel>

            <!-- Data files & setup -->
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionhead" Text="DATA FILES &amp; SETUP" />
              <Border Classes="panel" Padding="4">
                <StackPanel>
                  <Button Classes="row" Click="OnHomeDecrypt">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="KeyVariant" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Decrypt EDAT / SDAT" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Decrypt an NPDRM data file to plaintext." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EDAT" /></Border>
                        <Border Classes="chip"><TextBlock Text="PS3 / PSP" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Click="OnHomeKeys">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="CogOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Manage keys…" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Import an override key or set the folder." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="SETUP" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== Suggested page (package-aware next actions) ===== -->
        <Grid x:Name="SuggestedPage" IsVisible="{Binding IsSuggestedTool}">
          <TextBlock IsVisible="{Binding !HasPackage}"
                     Text="Open a .pkg file to see suggested actions."
                     TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45" />

          <ScrollViewer IsVisible="{Binding HasPackage}">
            <Panel DataContext="{Binding Package}">
              <StackPanel x:DataType="vm:PackageViewModel"
                          Margin="24,20" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
              <Grid ColumnDefinitions="Auto,*">
                <Image Grid.Column="0" Source="{Binding Icon}" Width="56" Height="56" Margin="0,0,12,0"
                       VerticalAlignment="Center" IsVisible="{Binding HasIcon}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis" />
                   <TextBlock Text="{Binding ContentIdRaw}" FontFamily="Consolas,monospace" FontSize="11"
                              Opacity="0.7" TextTrimming="CharacterEllipsis" />
                   <TextBlock Text="{Binding ClassificationLine}" FontSize="12" FontWeight="SemiBold"
                              TextWrapping="Wrap" />
                   <TextBlock Text="{Binding SummaryLine}" FontSize="11" Opacity="0.7" />
                </StackPanel>
              </Grid>

              <Border Classes="panel" Padding="14,11">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding RecommendationHeading}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="{Binding RecommendationSummary}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                </StackPanel>
              </Border>

              <StackPanel Spacing="8">
                <TextBlock Classes="sectionhead" Text="RECOMMENDED ACTIONS" />
                <Border Classes="panel" Padding="4">
                  <ItemsControl ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:PackageActionRecommendation">
                        <Button Classes="row" Tag="{Binding}" Click="OnRecommendedActionClick"
                                HorizontalContentAlignment="Stretch">
                          <Grid ColumnDefinitions="34,*,Auto">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="LightbulbOnOutline" Width="20" Height="20"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,12,0" VerticalAlignment="Center">
                              <TextBlock Classes="rowtitle" Text="{Binding Title}" />
                              <TextBlock Classes="carddesc" Text="{Binding Description}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Badge}" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>

              <Button Content="Browse package files →" Click="OnBrowsePackageClick"
                      HorizontalAlignment="Left" Padding="12,6" />
              </StackPanel>
            </Panel>
          </ScrollViewer>
        </Grid>

        <!-- ===== Package page (inspector) ===== -->
        <Grid x:Name="PackagePage" IsVisible="{Binding IsPackageTool}">
          <TextBlock IsVisible="{Binding !HasPackage}"
                     Text="Open a .pkg file (File → Open), or drag one onto the window."
                     TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45" />

          <Border IsVisible="{Binding HasPackage}">
            <Panel DataContext="{Binding Package}">
              <DockPanel x:DataType="vm:PackageViewModel">

                <!-- Package info header strip -->
                <Border DockPanel.Dock="Top" Padding="10,7"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Image Grid.Column="0" Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,10,0"
                           VerticalAlignment="Center" IsVisible="{Binding HasIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                       <TextBlock Text="{Binding ContentIdRaw}" FontFamily="Consolas,monospace" FontSize="11"
                                  Opacity="0.7" TextTrimming="CharacterEllipsis" />
                       <TextBlock Text="{Binding ClassificationLine}" FontSize="11" FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="Package platform, library role, region, and SFO category" />
                       <TextBlock Text="{Binding SummaryLine}" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusCounts}" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.8" Margin="10,0,0,0" TextAlignment="Right" />
                  </Grid>
                </Border>

                <!-- Decryption warning banner (only when contents couldn't be decrypted) -->
                <Border DockPanel.Dock="Top" IsVisible="{Binding ShowDecryptionWarning}" Padding="10,6"
                        Background="#33D08A00" BorderBrush="#D08A00" BorderThickness="0,0,0,1">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⚠" VerticalAlignment="Center" Foreground="#D08A00" FontSize="14" />
                    <TextBlock Text="{Binding DecryptionNote}" TextWrapping="Wrap" FontSize="12"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="8,6"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0" Text="{Binding FileFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="Filter files by name or path…" />
                    <TextBlock Grid.Column="1" Text="{Binding FilterSummary}" IsVisible="{Binding HasFileFilter}"
                               Margin="10,0" VerticalAlignment="Center" FontSize="11" Opacity="0.65" />
                    <Button Grid.Column="2" Content="Clear" Click="OnClearFileFilter"
                            IsVisible="{Binding HasFileFilter}" Padding="8,3" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <!-- Selected-file detail line -->
                <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasSelectedFile}" Padding="10,4"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
                  <TextBlock Text="{Binding SelectedFileDetail}" FontSize="12" FontFamily="Consolas,monospace"
                             Opacity="0.85" TextTrimming="CharacterEllipsis" />
                </Border>

                <Grid ColumnDefinitions="220,4,*">

                <!-- Folder tree -->
                <TreeView Grid.Column="0" ItemsSource="{Binding FolderRoots}"
                          SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                      <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                    </Style>
                  </TreeView.Styles>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding DirectoryChildren}" x:DataType="vm:EntryNode">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding Icon}" />
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                              Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                <!-- File list -->
                <DataGrid Grid.Column="2" ItemsSource="{Binding CurrentItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          DoubleTapped="OnGridDoubleTapped" PointerPressed="OnGridPointerPressed"
                          IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="None" HeadersVisibility="Column">
                  <DataGrid.ContextMenu>
                    <ContextMenu x:DataType="vm:PackageViewModel">
                      <MenuItem Header="View" Click="OnViewClick" />
                      <MenuItem Header="Extract…" Click="OnExtractClick" />
                      <MenuItem Header="Replace…" Click="OnReplaceClick" />
                      <Separator IsVisible="{Binding HasSelectedPspTool}" />
                      <MenuItem Header="Decrypt manual (DOCUMENT.DAT)…" Click="OnDecryptManual"
                                IsVisible="{Binding SelectedIsDocument}" />
                      <MenuItem Header="Unpack PBP…" Click="OnUnpackPbp"
                                IsVisible="{Binding SelectedIsPbp}" />
                      <MenuItem Header="Extract PSP ISO…" Click="OnExtractPspIso"
                                IsVisible="{Binding SelectedIsPbp}" />
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:EntryNode">
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0">
                            <TextBlock Text="{Binding Icon}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <Border IsVisible="{Binding HasBadge}" VerticalAlignment="Center"
                                    Background="{DynamicResource SystemAccentColor}" CornerRadius="3" Padding="4,1"
                                    ToolTip.Tip="PSP-encrypted entry — its data uses the PSP AES key, not the PS3 key.">
                              <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Path" Binding="{Binding FullPath}"
                                        SortMemberPath="FullPath" Width="2*" MinWidth="120" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}"
                                        SortMemberPath="Size" Width="130" MinWidth="80" />
                  </DataGrid.Columns>
                </DataGrid>

                </Grid>
              </DockPanel>
            </Panel>
          </Border>
        </Grid>

        <!-- ===== Pack page ===== -->
        <ScrollViewer x:Name="PackPage" IsVisible="{Binding IsPackTool}">
          <StackPanel Margin="24,20" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="3">
              <TextBlock Classes="pagetitle" Text="Pack folder → .pkg" />
              <TextBlock Classes="pagesubtitle"
                         Text="Build a package from a content folder. Fields are pre-filled from the folder's PARAM.SFO where possible." />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border Classes="chip"><TextBlock Text="PKG" /></Border>
                <Border Classes="chip cfw"><TextBlock Text="CEX · CFW" /></Border>
                <Border Classes="chip debug"><TextBlock Text="DEX · OFW" /></Border>
              </StackPanel>
            </StackPanel>

            <!-- Source -->
            <Border Classes="panel">
              <StackPanel Spacing="12">
                <TextBlock Classes="sectionhead" Text="SOURCE" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,10,Auto,10,Auto,10,Auto,10,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldlabel" Text="Source folder" />
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Browse…" Click="OnPackBrowseFolder" />
                    <TextBlock x:Name="PackFolderText" VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" Text="(none)" />
                  </StackPanel>

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldlabel" Text="Content ID" />
                  <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PackContentIdBox"
                             Watermark="UP0001-NPUB30910_00-EXAMPLE000000001" FontFamily="Consolas,monospace" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Classes="fieldlabel" Text="Install dir" />
                  <TextBox   Grid.Row="4" Grid.Column="1" x:Name="PackInstallDirBox" Watermark="NPUB30910" />

                  <TextBlock Grid.Row="6" Grid.Column="0" Classes="fieldlabel" Text="Content type" />
                  <ComboBox  Grid.Row="6" Grid.Column="1" x:Name="PackContentTypeBox" HorizontalAlignment="Stretch" />

                  <TextBlock Grid.Row="8" Grid.Column="0" Classes="fieldlabel" Text="DRM type" />
                  <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <NumericUpDown x:Name="PackDrmBox" Minimum="0" Maximum="255" Increment="1" Value="3"
                                   ValueChanged="OnPackDrmChanged" HorizontalAlignment="Left" Width="120" />
                    <TextBlock x:Name="PackDrmName" VerticalAlignment="Center" FontSize="12" Opacity="0.8" Text="Free" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Output -->
            <Border Classes="panel">
              <StackPanel Spacing="12">
                <TextBlock Classes="sectionhead" Text="OUTPUT" />
                <StackPanel Spacing="12">
                  <RadioButton x:Name="PackRetailRadio" GroupName="PackFin" IsChecked="True" VerticalContentAlignment="Top">
                    <StackPanel Spacing="3" Margin="2,1,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Retail-encrypted" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Border Classes="chip cfw" VerticalAlignment="Center"><TextBlock Text="CEX · CFW" /></Border>
                      </StackPanel>
                      <TextBlock Classes="carddesc" MaxWidth="520"
                                 Text="Installs on jailbroken firmware / HEN. Unsigned — CFW skips the signature check." />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="PackDebugRadio" GroupName="PackFin" VerticalContentAlignment="Top">
                    <StackPanel Spacing="3" Margin="2,1,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Non-finalized (debug)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Border Classes="chip debug" VerticalAlignment="Center"><TextBlock Text="DEX · OFW" /></Border>
                      </StackPanel>
                      <TextBlock Classes="carddesc" MaxWidth="520"
                                 Text="Self-contained; opens in RPCS3 and debug / reference (DEX) consoles." />
                    </StackPanel>
                  </RadioButton>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                <StackPanel Spacing="6">
                  <CheckBox x:Name="PackResignCheck"
                            Content="Resign EBOOT.BIN as it packs (boots on CFW without its license)" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
                    <Button Content="Override RAP…" Click="OnPackPickRap" />
                    <TextBlock x:Name="PackRapText" VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" Text="(auto from RAP library)" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Pack…" Click="OnPackBuild" />
              <Button Content="Show folder info…" Click="OnPackFolderInfo" />
            </StackPanel>

            <TextBlock x:Name="PackNotes" TextWrapping="Wrap" FontSize="12" Opacity="0.7" IsVisible="False" />

            <Border x:Name="FolderInfoBox" Classes="panel" IsVisible="False">
              <TextBlock x:Name="FolderInfoText" FontFamily="Consolas,monospace" FontSize="12" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== Resign page ===== -->
        <ScrollViewer x:Name="ResignPage" IsVisible="{Binding IsResignTool}">
          <StackPanel Margin="24,20" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Classes="pagetitle" Text="SELF / EBOOT Resigner" />

            <!-- Menu: a compact list of the tools on this page -->
            <StackPanel x:Name="ResignMenu" Spacing="10">
              <TextBlock Classes="pagesubtitle"
                         Text="Keyless SELF / EBOOT tools, grouped by target — CEX CFW today; DEX OFW resign isn't built yet." />

              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <Border Classes="chip cfw"><TextBlock Text="CEX · CFW" /></Border>
                <TextBlock Text="retail console · custom firmware" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
              </StackPanel>
              <Border Classes="panel" Padding="4">
                <StackPanel>
                  <Button Classes="row" Tag="inspect" Click="OnResignCardClick"
                          ToolTip.Tip="Read a SELF/EBOOT header without decrypting.">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Inspect SELF / EBOOT" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Header — type, key rev, segments." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EBOOT" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Tag="decrypt" Click="OnResignCardClick"
                          ToolTip.Tip="Recover a plaintext ELF from an encrypted EBOOT.BIN / .self.">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="LockOpenOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Decrypt SELF → ELF" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="EBOOT.BIN / .self to a plaintext ELF." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EBOOT" /></Border>
                        <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Tag="fakesign" Click="OnResignCardClick"
                          ToolTip.Tip="Wrap a plaintext ELF as a fake-signed SELF that boots on CFW.">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="DrawPen" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Fake-sign ELF → fSELF" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="A CFW-ready fSELF from a plain ELF." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EBOOT" /></Border>
                        <Border Classes="chip cfw"><TextBlock Text="CFW" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Tag="magic" Click="OnResignCardClick"
                          ToolTip.Tip="Lower the firmware an EBOOT demands so it boots on a lower CFW.">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="ArrowDownBoldBox" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Magic-patch firmware" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Lower the firmware an EBOOT requires." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EBOOT" /></Border>
                        <Border Classes="chip cfw"><TextBlock Text="CFW" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="row" Tag="byte" Click="OnResignCardClick"
                          ToolTip.Tip="Apply raw hex edits to an EBOOT/ELF.">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="CodeBraces" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="rowtitle" Text="Byte-patch EBOOT" />
                        <TextBlock Classes="carddesc" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Hex find/replace or at-offset edit." />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="EBOOT" /></Border>
                        <Border Classes="chip cfw"><TextBlock Text="CFW" /></Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Border Classes="chip debug"><TextBlock Text="DEX · OFW" /></Border>
                <TextBlock Text="debug console · official firmware" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="carddesc" Margin="2,0,0,0"
                         Text="No DEX OFW resign yet — resigning SELFs for debug (DEX) firmware isn't built. For DEX today, build a debug .pkg from the Pack page." />
            </StackPanel>

            <!-- Detail: one focused operation at a time -->
            <StackPanel x:Name="ResignDetail" IsVisible="False" Spacing="10">
              <Button Classes="back" Content="‹  All resign tools" Click="OnResignBack" />

              <!-- Inspect -->
              <StackPanel x:Name="ResignOpInspect" IsVisible="False" Spacing="10">
                <TextBlock Text="Inspect SELF / EBOOT" FontWeight="SemiBold" FontSize="14" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                           Text="Read a SELF/EBOOT header — program type, key revision, control blocks and segments. No key needed." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Browse SELF / EBOOT…" Click="OnSelfBrowse" />
                  <TextBlock x:Name="SelfFileText" VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                             TextTrimming="CharacterEllipsis" Text="(none)" />
                </StackPanel>
                <Border x:Name="SelfInfoBox" IsVisible="False"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="12">
                  <TextBlock x:Name="SelfInfoText" FontFamily="Consolas,monospace" FontSize="12" TextWrapping="Wrap" />
                </Border>
              </StackPanel>

              <!-- Fake-sign ELF → fSELF -->
              <StackPanel x:Name="ResignOpFakeSign" IsVisible="False" Spacing="10">
                <TextBlock Text="Fake-sign ELF → fSELF" FontWeight="SemiBold" FontSize="14" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                           Text="Pick a decrypted ELF; PkgLens writes a fake-signed NON-DRM SELF (no keys). It runs on CFW — signature checks patched — not on stock retail." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Fake-sign an ELF…" Click="OnMakeFself" />
                  <CheckBox x:Name="FselfNpdrmCheck" Content="NPDRM (app type 8)" VerticalAlignment="Center"
                            ToolTip.Tip="Tag the fSELF as NPDRM (app type 8) for use inside an NPDRM package, instead of a plain app (type 4)." />
                </StackPanel>
                <Expander x:Name="FselfCustomExpander" Header="Custom sign fields (optional)">
                  <StackPanel Spacing="8" Margin="0,4">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                               Text="Advanced — leave every field blank to use the standard fSELF defaults, which is what most repacks want. Each field matches a specific SDK / firmware / console profile; fill only the ones you need. Hover a box for what it does." />
                    <Grid ColumnDefinitions="100,10,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto,6,Auto,6,Auto,6,Auto,6,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Auth ID" VerticalAlignment="Center" />
                      <TextBox   Grid.Row="0" Grid.Column="2" x:Name="FselfAuthIdBox"
                                 Watermark="0x1010000001000003" FontFamily="Consolas,monospace"
                                 ToolTip.Tip="app_info authentication id (16 hex digits). Blank = the standard fSELF default 0x1010000001000003." />
                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Vendor ID" VerticalAlignment="Center" />
                      <TextBox   Grid.Row="2" Grid.Column="2" x:Name="FselfVendorIdBox"
                                 Watermark="0x01000002" FontFamily="Consolas,monospace"
                                 ToolTip.Tip="app_info vendor id (up to 8 hex digits). Blank = the default 0x01000002." />
                      <TextBlock Grid.Row="4" Grid.Column="0" Text="App version" VerticalAlignment="Center" />
                      <TextBox   Grid.Row="4" Grid.Column="2" x:Name="FselfAppVerBox"
                                 Watermark="0x0001000000000000" FontFamily="Consolas,monospace"
                                 ToolTip.Tip="app_info version field (16 hex digits). Blank = the default 0x0001000000000000." />
                      <TextBlock Grid.Row="6" Grid.Column="0" Text="FW version" VerticalAlignment="Center" />
                      <TextBox   Grid.Row="6" Grid.Column="2" x:Name="FselfFwVerBox"
                                 Watermark="e.g. 4.46 (blank = unset)" FontFamily="Consolas,monospace"
                                 ToolTip.Tip="Minimum firmware the executable claims to need, as M.NN (e.g. 4.46), written into the SELF's digest block. Blank = leave it unset." />
                      <TextBlock Grid.Row="8" Grid.Column="0" Text="Control flags" VerticalAlignment="Center" />
                      <TextBox   Grid.Row="8" Grid.Column="2" x:Name="FselfCtrlFlagsBox"
                                 Watermark="e.g. 0000…0000 — 64 hex chars (blank = omit)" FontFamily="Consolas,monospace"
                                 ToolTip.Tip="The 32-byte SELF control-flags block, as exactly 64 hex characters. Advanced; blank = omit the block entirely (the default)." />
                      <TextBlock Grid.Row="10" Grid.Column="0" Text="Content ID" VerticalAlignment="Center" />
                      <TextBox   Grid.Row="10" Grid.Column="2" x:Name="FselfContentIdBox"
                                 Watermark="UP0001-NPUB30910_00-EXAMPLE000000001" FontFamily="Consolas,monospace"
                                 ToolTip.Tip="NPDRM content id (37 chars). Used only with the NPDRM option; blank = the fake default id." />
                      <TextBlock Grid.Row="12" Grid.Column="0" Text="NP license" VerticalAlignment="Center" />
                      <TextBox   Grid.Row="12" Grid.Column="2" x:Name="FselfNpLicenseBox"
                                 Watermark="FREE | LOCAL | NETWORK (blank = default LOCAL)" FontFamily="Consolas,monospace"
                                 ToolTip.Tip="NPDRM license type written into the control block. NPDRM only; blank = the default (LOCAL)." />
                      <TextBlock Grid.Row="14" Grid.Column="0" Text="NP app type" VerticalAlignment="Center" />
                      <TextBox   Grid.Row="14" Grid.Column="2" x:Name="FselfNpAppTypeBox"
                                 Watermark="SPRX | EXEC | USPRX | UEXEC (blank = default EXEC)" FontFamily="Consolas,monospace"
                                 ToolTip.Tip="NPDRM app type (U* = update). NPDRM only; blank = the default (EXEC)." />
                    </Grid>
                  </StackPanel>
                </Expander>
                <TextBlock x:Name="FselfNotes" TextWrapping="Wrap" FontSize="12" Opacity="0.7" IsVisible="False" />
              </StackPanel>

              <!-- Decrypt SELF → ELF -->
              <StackPanel x:Name="ResignOpDecrypt" IsVisible="False" Spacing="10">
                <TextBlock Text="Decrypt SELF → ELF" FontWeight="SemiBold" FontSize="14" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                           Text="Decrypt an encrypted EBOOT.BIN / .self back to a plaintext ELF. Licensed SELFs resolve RAPs automatically from the library." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Decrypt EBOOT.BIN → ELF…" Click="OnUnself" />
                  <CheckBox x:Name="UnselfThenResignCheck" Content="then fake-sign to fSELF" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Override RAP…" Click="OnPickRap" />
                  <TextBlock x:Name="UnselfRapText" VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                             TextTrimming="CharacterEllipsis" Text="(auto from RAP library)" />
                </StackPanel>
                <Border x:Name="UnselfBanner" Classes="resultbanner" IsVisible="False">
                  <Grid ColumnDefinitions="Auto,10,*,Auto">
                    <TextBlock Grid.Column="0" x:Name="UnselfBannerIcon" Classes="bannericon" Text="✓" />
                    <StackPanel Grid.Column="2" Spacing="3">
                      <TextBlock x:Name="UnselfBannerTitle" Classes="bannertitle" />
                      <SelectableTextBlock x:Name="UnselfBannerPath" Classes="bannerpath" IsVisible="False" />
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="UnselfBannerShow" Content="Show in folder"
                            Click="OnShowResultInFolder" IsVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" />
                  </Grid>
                </Border>
              </StackPanel>

              <!-- Magic-patch firmware -->
              <StackPanel x:Name="ResignOpMagic" IsVisible="False" Spacing="10">
                <TextBlock Text="Magic-patch firmware" FontWeight="SemiBold" FontSize="14" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                           Text="Lower the firmware version an EBOOT demands so a higher-firmware game boots on a lower CFW. Pick an EBOOT.BIN/.self (decrypted automatically) or a plaintext ELF; the result is fake-signed." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Target firmware" VerticalAlignment="Center" FontSize="12" />
                  <TextBox x:Name="MagicFwBox" Width="90" Watermark="4.00" FontFamily="Consolas,monospace"
                           ToolTip.Tip="The firmware version to write into the EBOOT's SDK field, e.g. 4.00 — lower it so a higher-firmware game boots on a lower CFW." />
                  <Button Content="Magic-patch EBOOT…" Click="OnMagicPatch" />
                </StackPanel>
                <TextBlock x:Name="MagicNotes" TextWrapping="Wrap" FontSize="12" Opacity="0.7" IsVisible="False" />
              </StackPanel>

              <!-- Byte-patch EBOOT -->
              <StackPanel x:Name="ResignOpByte" IsVisible="False" Spacing="10">
                <TextBlock Text="Byte-patch EBOOT" FontWeight="SemiBold" FontSize="14" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                           Text="Apply raw byte edits to an EBOOT/ELF — a hex find→replace (equal length) and/or an at-offset overwrite. A SELF/EBOOT input is decrypted first; tick 'fake-sign' to write the result back as a CFW-ready fSELF." />
                <Grid ColumnDefinitions="86,10,*" RowDefinitions="Auto,6,Auto,6,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Find (hex)" VerticalAlignment="Center" FontSize="12" />
                  <TextBox   Grid.Row="0" Grid.Column="2" x:Name="PatchFindBox" Watermark="e.g. 90909090"
                             FontFamily="Consolas,monospace"
                             ToolTip.Tip="Bytes to search for, as hex. Replaced everywhere it occurs. Leave blank to skip find/replace." />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Replace (hex)" VerticalAlignment="Center" FontSize="12" />
                  <TextBox   Grid.Row="2" Grid.Column="2" x:Name="PatchReplaceBox" Watermark="same length as find"
                             FontFamily="Consolas,monospace"
                             ToolTip.Tip="Replacement bytes, as hex. Must be exactly the same length as Find." />
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="At offset" VerticalAlignment="Center" FontSize="12" />
                  <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <TextBox x:Name="PatchAtOffsetBox" Width="110" Watermark="0x1234" FontFamily="Consolas,monospace"
                             ToolTip.Tip="Offset into the ELF to overwrite (0x-hex or decimal). Leave blank to skip." />
                    <TextBlock Text="=" VerticalAlignment="Center" />
                    <TextBox x:Name="PatchAtBytesBox" Width="200" Watermark="hex bytes" FontFamily="Consolas,monospace"
                             ToolTip.Tip="Bytes to write at the offset, as hex." />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Byte-patch EBOOT…" Click="OnBytePatch" />
                  <CheckBox x:Name="BytePatchResignCheck" Content="fake-sign output (fSELF)" VerticalAlignment="Center"
                            ToolTip.Tip="Write the patched result as a fake-signed SELF. Always on when the input was a SELF/EBOOT.BIN." />
                  <CheckBox x:Name="BytePatchNpdrmCheck" Content="NPDRM" VerticalAlignment="Center"
                            ToolTip.Tip="Tag the fSELF as NPDRM (app type 8)." />
                </StackPanel>
                <TextBlock x:Name="BytePatchNotes" TextWrapping="Wrap" FontSize="12" Opacity="0.7" IsVisible="False" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== Decrypt page ===== -->
        <ScrollViewer x:Name="DecryptPage" IsVisible="{Binding IsDecryptTool}">
          <StackPanel Margin="24,20" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="3">
              <TextBlock Classes="pagetitle" Text="Decrypt EDAT / SDAT" />
              <TextBlock Classes="pagesubtitle"
                         Text="Decrypt an NPDRM data file. Licensed EDATs resolve RAPs automatically from the library." />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border Classes="chip"><TextBlock Text="EDAT" /></Border>
                <Border Classes="chip"><TextBlock Text="PS3 / PSP" /></Border>
                <Border Classes="chip"><TextBlock Text="READ-ONLY" /></Border>
              </StackPanel>
            </StackPanel>

            <Border Classes="panel">
              <StackPanel Spacing="12">
                <TextBlock Classes="sectionhead" Text="INPUT" />
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,10,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldlabel" Text="EDAT file" />
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Browse…" Click="OnDecryptBrowseFile" />
                    <TextBlock x:Name="DecryptFileText" VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" Text="(none)" />
                  </StackPanel>

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldlabel" Text="RAP override" />
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Browse…" Click="OnDecryptBrowseRap" />
                    <TextBlock x:Name="DecryptRapText" VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" Text="(auto / not needed)" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Decrypt…" Click="OnDecryptRun" />
              <Button x:Name="DecryptViewButton" Content="View result…" Click="OnDecryptView" IsVisible="False"
                      ToolTip.Tip="Show the decrypted file's contents (image, text, or hex)." />
            </StackPanel>

            <Border x:Name="DecryptBanner" Classes="resultbanner" IsVisible="False">
              <Grid ColumnDefinitions="Auto,10,*,Auto">
                <TextBlock Grid.Column="0" x:Name="DecryptBannerIcon" Classes="bannericon" Text="✓" />
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock x:Name="DecryptBannerTitle" Classes="bannertitle" />
                  <SelectableTextBlock x:Name="DecryptBannerPath" Classes="bannerpath" IsVisible="False" />
                </StackPanel>
                <Button Grid.Column="3" x:Name="DecryptBannerShow" Content="Show in folder"
                        Click="OnShowResultInFolder" IsVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== Keys page ===== -->
        <ScrollViewer x:Name="KeysPage" IsVisible="{Binding IsKeysTool}">
          <StackPanel Margin="24,20" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="3">
              <TextBlock Classes="pagetitle" Text="Keys" />
              <TextBlock Classes="pagesubtitle"
                         Text="Package keys are selected automatically. Manage RAP licenses here so licensed EDATs and EBOOTs decrypt without choosing a RAP for every operation." />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border Classes="chip"><TextBlock Text="SETUP" /></Border>
              </StackPanel>
            </StackPanel>

            <Border Classes="panel">
              <StackPanel Spacing="12">
                <TextBlock Classes="sectionhead" Text="STATUS" />
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding KeyStatus}" FontSize="12" Opacity="0.85" />
                  <TextBlock Text="{Binding KeysDirectory, FallbackValue='keys folder: default (~/.pkglens)'}"
                             FontSize="12" Opacity="0.6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Import override key…" Click="OnSetKeyClick" />
                  <Button Content="Set keys folder…" Click="OnKeysClick" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="12">
                <TextBlock Classes="sectionhead" Text="RAP LIBRARY" />
                <TextBlock Text="{Binding RapStatus}" FontSize="12" Opacity="0.85" />
                <TextBlock Text="{Binding RapDirectoryDisplay}"
                           FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                <Button Content="Manage RAP library…" Click="OnManageRapsClick" HorizontalAlignment="Left" />
                <Separator />
                <TextBlock Classes="sectionhead" Text="NEARBY RAP DISCOVERY" />
                <TextBlock Text="{Binding RapSearchDirectoriesDisplay}" FontSize="12" Opacity="0.7"
                           TextWrapping="Wrap" MaxLines="3" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Choose search folders…" Click="OnRapSearchFoldersClick" />
                  <Button Content="Clear" Click="OnClearRapSearchFoldersClick"
                          IsEnabled="{Binding HasRapSearchDirectories}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Classes="pagesubtitle" Opacity="0.55"
                       Text="When a required RAP is missing, PkgLens searches beside the input and in selected folders, validates matching content-ID filenames, and offers to import valid 16-byte RAPs." />
          </StackPanel>
        </ScrollViewer>

        <!-- Drag-and-drop overlay (global) -->
        <Border x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False" Background="#99000000">
          <Border Margin="24" BorderBrush="White" BorderThickness="2" CornerRadius="4">
            <TextBlock Text="Drop a .pkg to open it · Drop a folder for batch processing" FontSize="18" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Border>

      </Grid>
    </Grid>
  </DockPanel>
</Window>

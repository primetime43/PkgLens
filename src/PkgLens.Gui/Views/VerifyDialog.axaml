<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PkgLens.Gui.ViewModels"
        x:Class="PkgLens.Gui.Views.VerifyDialog"
        Width="540" Height="400"
        WindowStartupLocation="CenterOwner"
        Title="Verify integrity">

  <DockPanel Margin="14">
    <TextBlock x:Name="Summary" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
    <TextBlock DockPanel.Dock="Top" Opacity="0.6" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
               Text="Checks structural bounds, the header SHA-1 digest, and supported CMAC and ECDSA authentication. Repacked packages have an updated checksum but may fail the original authentication checks." />

    <Button DockPanel.Dock="Bottom" Content="Close" Click="OnClose" HorizontalAlignment="Right" Margin="0,12,0,0" />

    <ScrollViewer>
      <ItemsControl x:Name="Rows">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CheckRow">
            <Grid ColumnDefinitions="56,150,*" Margin="0,3">
              <TextBlock Grid.Column="0" Text="{Binding Mark}" Foreground="{Binding Color}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" />
              <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.8" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>

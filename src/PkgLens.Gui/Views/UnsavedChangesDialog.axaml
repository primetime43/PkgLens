<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PkgLens.Gui.ViewModels"
        x:Class="PkgLens.Gui.Views.UnsavedChangesDialog"
        x:DataType="vm:PackageViewModel"
        Title="Save your changes?" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock Classes="pagetitle" Text="Save your changes?" />
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding PendingChangesSummary}" />
    <TextBlock Classes="pagesubtitle" Text="Save a copy before continuing, or discard your pending edits. Cancel keeps this package open." />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsCancel="True" IsDefault="True" />
      <Button x:Name="DiscardButton" Content="Discard changes" Click="OnDiscard" />
      <Button x:Name="SaveButton" Classes="primary" Content="Save copy…" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PkgLens.Gui.ViewModels"
        x:Class="PkgLens.Gui.Views.ScanDialog"
        Width="920" Height="600"
        WindowStartupLocation="CenterOwner"
        Title="Scan folder">

  <DockPanel Margin="10">
    <StackPanel x:Name="InputPanel" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="Choose folder…" Click="OnChooseFolder" />
      <TextBlock x:Name="FolderText" VerticalAlignment="Center" Opacity="0.8"
                 MaxWidth="440" TextTrimming="CharacterEllipsis" Text="(no folder chosen)" />
      <CheckBox x:Name="RecursiveCheck" Content="Recursive" VerticalAlignment="Center" />
      <Button x:Name="ScanBtn" Content="Scan" Click="OnScan" IsEnabled="False" />
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <TextBlock x:Name="StatusText" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Opacity="0.8"
                  TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
        <Button x:Name="CsvBtn" Content="Save CSV…" Click="OnSaveCsv" IsEnabled="False" />
        <Button x:Name="JsonBtn" Content="Save JSON…" Click="OnSaveJson" IsEnabled="False" />
        <Button x:Name="CancelBtn" Content="Cancel" Click="OnCancel" IsVisible="False" />
        <Button Content="Close" Click="OnClose" />
      </StackPanel>
      <ProgressBar x:Name="ScanProgress" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                   Minimum="0" Maximum="100" Height="4" IsVisible="False" />
    </Grid>

    <DataGrid x:Name="Grid" IsReadOnly="True" GridLinesVisibility="Horizontal"
              HeadersVisibility="Column" CanUserSortColumns="True" CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" x:DataType="vm:ScanResultRow" />
        <DataGridTextColumn Header="Title ID" Binding="{Binding TitleId}" Width="100" x:DataType="vm:ScanResultRow" />
        <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="80" x:DataType="vm:ScanResultRow" />
        <DataGridTextColumn Header="Final" Binding="{Binding Finalization}" Width="80" x:DataType="vm:ScanResultRow" />
        <DataGridTextColumn Header="Ver" Binding="{Binding Version}" Width="70" x:DataType="vm:ScanResultRow" />
        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="110" x:DataType="vm:ScanResultRow" />
        <DataGridTextColumn Header="Dec" Binding="{Binding DecText}" Width="55" x:DataType="vm:ScanResultRow" />
        <DataGridTextColumn Header="File / Note" Binding="{Binding FileOrNote}" Width="240" x:DataType="vm:ScanResultRow" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>

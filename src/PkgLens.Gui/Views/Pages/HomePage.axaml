<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PkgLens.Gui.ViewModels"
             xmlns:core="using:PkgLens.Core.Shared"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PkgLens.Gui.Views.Pages.HomePage"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,24" Spacing="22" MaxWidth="900" HorizontalAlignment="Stretch">
      <StackPanel Spacing="6">
        <TextBlock Classes="pagetitle" Text="Start with a package" />
        <TextBlock Classes="pagesubtitle" Text="Open a .pkg to see what’s inside and choose what to do next." />
      </StackPanel>
      <Border Classes="panel" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="Inspect, extract, or edit package files" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="pagesubtitle" Text="PkgLens identifies the package and suggests compatible actions." />
          <WrapPanel>
            <Button x:Name="HomeOpenPackageButton" Classes="primary" Content="Open package…" Click="OnHomeOpenPkg" Padding="18,9" Margin="0,0,16,0" />
            <TextBlock Text="or drop a .pkg anywhere in this window" Classes="carddesc" VerticalAlignment="Center" Margin="0,8" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <StackPanel Spacing="8" IsVisible="{Binding HasRecentPackages}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="sectionhead" Text="Recent packages" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Clear history" Click="OnClearRecentPackages"
                  Padding="8,3" FontSize="11" />
        </Grid>
        <Border Classes="panel" Padding="4">
          <ScrollViewer MaxHeight="170">
            <ItemsControl ItemsSource="{Binding RecentPackages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentPackageItem">
                  <Button Classes="row" Tag="{Binding}" Click="OnRecentPackageClick"
                          ToolTip.Tip="{Binding FilePath}">
                    <Grid ColumnDefinitions="34,*">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="History" Width="20" Height="20"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Classes="rowtitle" Text="{Binding FileName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="carddesc" Text="{Binding DirectoryPath}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionhead" Text="More tools" Margin="0,0,0,2" />
        <Expander x:Name="LibraryTools" Classes="toolgroup" IsExpanded="False">
          <Expander.Header>
            <StackPanel Spacing="3">
              <TextBlock Text="Inspect and organize" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="carddesc" Text="Scan folders, find duplicates, inspect game info, and check licenses." />
            </StackPanel>
          </Expander.Header>
          <StackPanel Spacing="2">
            <Button Classes="row" Click="OnHomeScan">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderSearchOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Scan a folder…" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.ScanFolder}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Click="OnHomeOrganizer">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderMoveOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Duplicate / package organizer…" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.PackageOrganizer}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Click="OnHomeFolderInfo">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Game folder info…" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.GameFolderInfo}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Click="OnKeyLicenseAuditClick">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="ShieldKeyOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Key / license audit…" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.KeyLicenseAudit}" />
                </StackPanel>
              </Grid>
            </Button>
          </StackPanel>
        </Expander>
        <Expander x:Name="ExportTools" Classes="toolgroup" IsExpanded="False">
          <Expander.Header>
            <StackPanel Spacing="3">
              <TextBlock Text="Export and convert" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="carddesc" Text="Compatibility checks and exports for PSP, PS1, and PS Vita." />
            </StackPanel>
          </Expander.Header>
          <StackPanel Spacing="2">
            <Button Classes="row" Click="OnHomeConvertCfw">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="AutoFix" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Target compatibility and conversion…" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.TargetCompatibility}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Click="OnHomeExportPsp">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="Disc" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Export PSP package → PBP / ISO / CSO…" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.ExportPsp}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Click="OnHomeExportPs1">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="DiscPlayer" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Export PS1 Classic → BIN / CUE…" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.ExportPs1}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Click="OnHomeExportVita">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderMoveOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Export PSVita package…" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.ExportVita}" />
                </StackPanel>
              </Grid>
            </Button>
          </StackPanel>
        </Expander>
        <Expander x:Name="AdvancedTools" Classes="toolgroup" IsExpanded="False">
          <Expander.Header>
            <StackPanel Spacing="3">
              <TextBlock Text="Executables, decryption, and keys" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="carddesc" Text="SELF / EBOOT tools, EDAT / SDAT decryption, and key setup." />
            </StackPanel>
          </Expander.Header>
          <StackPanel Spacing="2">
            <Button Classes="row" Tag="inspect" Click="OnHomeResign">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Inspect SELF / EBOOT" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.InspectSelf}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Tag="decrypt" Click="OnHomeResign">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="LockOpenOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Decrypt SELF → ELF" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.DecryptSelf}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Tag="fakesign" Click="OnHomeResign">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="DrawPen" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Fake-sign ELF → fSELF" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.FakeSignSelf}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Tag="magic" Click="OnHomeResign">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="ArrowDownBoldBox" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Magic-patch firmware" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.PatchFirmware}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Tag="byte" Click="OnHomeResign">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="CodeBraces" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Byte-patch EBOOT" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.BytePatch}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Click="OnHomeDecrypt">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="KeyVariant" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Decrypt EDAT / SDAT" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.DecryptEdat}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Classes="row" Click="OnHomeKeys">
              <Grid ColumnDefinitions="34,*">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="CogOutline" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="rowtitle" Text="Manage keys…" />
                  <TextBlock Classes="carddesc" TextWrapping="Wrap" Text="{x:Static core:FeatureText.ManageKeys}" />
                </StackPanel>
              </Grid>
            </Button>
          </StackPanel>
        </Expander>
        <Expander x:Name="CompatibilityHelp" Classes="toolgroup" Header="Console compatibility explained" IsExpanded="False">
          <StackPanel Spacing="10">
            <TextBlock Classes="pagesubtitle" Text="CEX · CFW / HEN — retail consoles with custom firmware or HEN." />
            <TextBlock Classes="pagesubtitle" Text="DEX · OFW — debug consoles on official debug firmware. Debug packages also work in RPCS3." />
            <TextBlock Classes="pagesubtitle" Text="Read-only — inspects or decrypts to a separate file; nothing is signed or installed." />
            <TextBlock Classes="pagesubtitle" Text="Stock retail firmware requires Sony signatures. PkgLens cannot create packages for that target." />
          </StackPanel>
        </Expander>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

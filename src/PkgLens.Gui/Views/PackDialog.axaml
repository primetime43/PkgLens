<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PkgLens.Gui.Views.PackDialog"
        Title="Pack folder → .pkg"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="18" Spacing="10">

    <TextBlock TextWrapping="Wrap" FontSize="12"
               Text="Build a .pkg from a content folder. Fields are pre-filled from the folder's PARAM.SFO where possible — adjust as needed." />

    <Grid ColumnDefinitions="Auto,10,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto" Margin="0,4,0,0">

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Source folder" VerticalAlignment="Center" />
      <TextBlock Grid.Row="0" Grid.Column="2" x:Name="FolderText" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.8" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Content ID" VerticalAlignment="Center" />
      <TextBox   Grid.Row="2" Grid.Column="2" x:Name="ContentIdBox"
                 Watermark="UP0001-NPUB30910_00-EXAMPLE000000001"
                 FontFamily="Consolas,monospace" />

      <TextBlock Grid.Row="4" Grid.Column="0" Text="Install dir" VerticalAlignment="Center" />
      <TextBox   Grid.Row="4" Grid.Column="2" x:Name="InstallDirBox" Watermark="NPUB30910" />

      <TextBlock Grid.Row="6" Grid.Column="0" Text="Content type" VerticalAlignment="Center" />
      <ComboBox  Grid.Row="6" Grid.Column="2" x:Name="ContentTypeBox" HorizontalAlignment="Stretch" />

      <TextBlock Grid.Row="8" Grid.Column="0" Text="DRM type" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="8" Grid.Column="2" x:Name="DrmTypeBox"
                     Minimum="0" Maximum="255" Increment="1" Value="3" HorizontalAlignment="Left" Width="110" />
    </Grid>

    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4" />

    <TextBlock Text="Output type" />
    <StackPanel Spacing="4" Margin="4,0,0,0">
      <RadioButton x:Name="DebugRadio" GroupName="Fin" IsChecked="True"
                   Content="Non-finalized (debug) — self-contained, no key, opens in RPCS3/PkgLens" />
      <RadioButton x:Name="RetailRadio" GroupName="Fin"
                   Content="Retail-encrypted (needs key) — UNSIGNED, will not install on a real console" />
    </StackPanel>

    <TextBlock x:Name="NotesText" IsVisible="False" TextWrapping="Wrap" FontSize="11" Opacity="0.6" />
    <TextBlock x:Name="Feedback" IsVisible="False" TextWrapping="Wrap" FontSize="12" Foreground="#D08A00" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
      <Button Content="Pack…" Click="OnPack" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
